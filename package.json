{
  "name": "sketch-cleaner",
  "productName": "Sketch Cleaner",
  "version": "0.3.0",
  "description": "의류 도해 자동 정리 초안 · 직접 수정 및 로컬 저장",
  "private": true,
  "main": "dist/main/main.js",
  "author": "Sketch Cleaner",
  "license": "UNLICENSED",
  "scripts": {
    "prepare:model": "node scripts/prepare-model.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts *.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "onnxruntime-node": "1.30.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^44.9.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.4.1",
    "vitest": "^5.0.5"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
